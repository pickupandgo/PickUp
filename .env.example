# Copy to .env for local development. Never commit .env or real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Number of trusted reverse proxies in front of the app (0 when running locally).
TRUST_PROXY_HOPS=0
# Comma-separated browser origins allowed by CORS (admin web panel). Mobile apps do not need CORS.
CORS_ORIGINS=
# Serves OpenAPI docs at /docs. Keep false in production.
SWAGGER_ENABLED=true

# PostgreSQL. docker compose exposes the local database on 127.0.0.1:5433.
DATABASE_URL=postgresql://multipleride:multipleride_dev_password@localhost:5433/multipleride
DATABASE_POOL_MAX=10

# Auth: Firebase ID tokens (the Driver app signs in with Firebase Phone Auth).
AUTH_PROVIDER=firebase
AUTH_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
AUTH_ISSUER=https://securetoken.google.com/YOUR_FIREBASE_PROJECT_ID
AUTH_AUDIENCE=YOUR_FIREBASE_PROJECT_ID

# Razorpay. Use rzp_test_ keys until go-live. These values must only ever live on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you set in the Razorpay Dashboard (at least 32 random characters).
RAZORPAY_WEBHOOK_SECRET=
# Optional: the previous webhook secret, accepted while Razorpay retries older events after a rotation.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_API_BASE_URL=https://api.razorpay.com
RAZORPAY_TIMEOUT_MS=4000

# Business limits (OPEN_DECISIONS D-40, D-42). The server refuses to start until they are set.
# Amounts are in paise: 100 paise = Rs 1.
WALLET_TOPUP_MIN_PAISE=100
WALLET_TOPUP_MAX_PAISE=
ADMIN_ADJUSTMENT_MAX_PAISE=

# Trip engine (server to server). Comma-separated keys, 32-128 chars each; put the new key first
# during a rotation. Empty disables /v1/internal/*. Generate with: openssl rand -hex 32
INTERNAL_API_KEYS=

# Pickup/delivery online collection: disabled | razorpay_payment_link | razorpay_qr_code.
# Payment links work in Razorpay test mode; QR codes can only be paid in live mode (D-24).
COLLECTION_LINK_PROVIDER=disabled
# Minutes a collection QR stays payable (16-120).
COLLECTION_LINK_TTL_MINUTES=30

# Merchant settlement tracking (D-45): an ONLINE earning becomes payable only after Razorpay
# reports its customer payment as settled to Nikhil Enterprises.
#   razorpay   settlement reconciliation API (production; test mode never settles)
#   simulated  in-memory settlements via /v1/dev/simulate (non-production with rzp_test_ keys only)
#   disabled   nothing is ever settled, so no ONLINE earning becomes payable
SETTLEMENT_PROVIDER=razorpay
# Periodic pull (0 = only on the settlement.processed webhook, admin sync and before each batch).
SETTLEMENT_SYNC_INTERVAL_MINUTES=60
SETTLEMENT_SYNC_LOOKBACK_DAYS=7
# Earnings still waiting for their settlement after this many days are reported for review.
SETTLEMENT_OVERDUE_DAYS=5

# TDS on driver payouts waits for the CA (D-57). Must stay false; true is refused at startup.
TDS_ENABLED=false

# Weekly driver payouts through RazorpayX: disabled | razorpayx | simulated. razorpayx needs an
# activated RazorpayX account (D-46). simulated is for local end-to-end runs only (refused in
# production and with live keys). Payouts only ever go to bank accounts an admin has approved
# after a bank validation (D-49).
PAYOUT_PROVIDER=disabled
# Your RazorpayX business account number (the source account), not a driver's.
RAZORPAYX_ACCOUNT_NUMBER=
# Optional separate RazorpayX API keys; defaults to RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
# Secret of the RazorpayX webhook (RazorpayX Dashboard > Developer Controls), 32+ characters.
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_WEBHOOK_SECRET_PREVIOUS=
PAYOUT_MODE=IMPS
# Shown on the driver's bank statement: up to 30 letters, digits or spaces.
PAYOUT_NARRATION=Nikhil Enterprises Payout
PAYOUT_QUEUE_IF_LOW_BALANCE=true
# Weekly schedule (approved, D-48): every Monday at 11:00 IST. Weekday is ISO: 1 = Monday ... 7 = Sunday.
PAYOUT_SCHEDULE_ENABLED=false
PAYOUT_SCHEDULE_WEEKDAY=1
PAYOUT_SCHEDULE_TIME=11:00
PAYOUT_SCHEDULE_TIMEZONE=Asia/Kolkata
# false: the scheduler only prepares the weekly batch and an admin executes it.
PAYOUT_AUTO_EXECUTE=false
