# MultipleRide Partner — environment template
# Copy this file to .env and supply local values. The .env file is git-ignored.
# Consumed at build time by react-native-config (JS) and dotenv.gradle (Android).

# Core engine REST API base URL (no trailing slash)
API_BASE_URL=https://pickup-backend-engine-v2.onrender.com

# Core engine WebSocket endpoint (real-time features)
WS_ENDPOINT=wss://pickup-backend-engine-v2.onrender.com

# Supply your restricted Google Maps Platform API key locally.
GOOGLE_MAPS_API_KEY=

# Payments + driver wallet backend (raj_backend) base URL, no trailing slash.
# Release builds accept HTTPS. Development builds also accept HTTP for local testing:
#   - phone over USB: http://localhost:3000, after adb reverse tcp:3000 tcp:3000
#   - Android emulator: http://10.0.2.2:3000
#   - phone on the same Wi-Fi: http://<laptop-LAN-IP>:3000
# Leave empty when this backend is not configured.
PAYMENTS_API_BASE_URL=
