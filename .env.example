# Public base URL of the Pickup-Go-Core-Engine backend, no trailing slash.
# Must be reachable over the internet (not localhost / LAN) so testers on other
# networks can use the app. HTTPS is required for store builds.
#   e.g. https://pickup-engine.onrender.com
EXPO_PUBLIC_API_BASE_URL=https://pickup-backend-engine-v2.onrender.com

# Google Maps Platform key with "Places API" and "Geocoding API" enabled.
# Restrict it by platform (iOS bundle id + Android package name) in Google Cloud
# Console: anything in EXPO_PUBLIC_* ships inside the app bundle.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyCqXIz_od_lQznfIxw01a5cGIWHZvJG4r8
