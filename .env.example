# MultipleRide trip engine (engine-v2). Copy to .env for local development only. In production
# every value comes from the platform's environment or secret manager. Never commit .env.
NODE_ENV=development
# The payment backend (raj_backend) uses 3000 locally, so the engine runs next to it on 3002.
PORT=3002

# The engine's own PostgreSQL database. Never the payment backend's: the engine reaches that only
# through its internal HTTP API. docker compose exposes the local server on 127.0.0.1:5433.
DATABASE_URL=postgresql://multipleride:multipleride_dev_password@localhost:5433/multipleride_engine
DATABASE_POOL_MAX=10

# Firebase ID tokens of the Customer and Driver apps. Same Firebase project as the payment
# backend: AUTH_ISSUER and AUTH_AUDIENCE must be identical to its values.
AUTH_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
AUTH_ISSUER=https://securetoken.google.com/YOUR_FIREBASE_PROJECT_ID
AUTH_AUDIENCE=YOUR_FIREBASE_PROJECT_ID

# The payment backend's internal API (/v1/internal/*). The key is one of the backend's
# INTERNAL_API_KEYS: 32-128 characters of A-Z a-z 0-9 _ - (generate with: openssl rand -hex 32).
# It lives on the engine's server only, never in an app.
PAYMENT_BACKEND_URL=http://localhost:3000
PAYMENT_BACKEND_INTERNAL_API_KEY=
PAYMENT_BACKEND_TIMEOUT_MS=5000
# Production refuses an http:// PAYMENT_BACKEND_URL unless this is true (private network only).
PAYMENT_BACKEND_ALLOW_HTTP=false

# Outbox: every engine -> payment backend report, retried until the backend answers.
# Background sender interval (0 turns it off; tests only).
OUTBOX_POLL_INTERVAL_MS=1000
# A sender holds a record this long; must be longer than PAYMENT_BACKEND_TIMEOUT_MS.
OUTBOX_LEASE_SECONDS=30
# Exponential backoff with jitter between attempts, from the base up to the maximum.
OUTBOX_BASE_BACKOFF_MS=1000
OUTBOX_MAX_BACKOFF_MS=300000
# Log "alert":"ENGINE_OUTBOX_STUCK" after this many attempts without an answer, and again every
# as many attempts.
OUTBOX_ALERT_AFTER_ATTEMPTS=8

# How long a driver has to answer an offer (technical default; dispatch rules are D-30).
OFFER_TTL_SECONDS=15
