# PickUp Driver — environment configuration
# Consumed at build time by react-native-config (JS) and dotenv.gradle (Android).
# This file holds real values and is git-ignored. See .env.example for the template.

# Core engine REST API base URL (no trailing slash)
API_BASE_URL=https://pickup-backend-engine-v2.onrender.com

# Core engine WebSocket endpoint (real-time features)
WS_ENDPOINT=wss://pickup-backend-engine-v2.onrender.com

