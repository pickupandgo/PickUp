# PickUp Driver — environment configuration template
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
#
# Consumed at build time by:
#   - react-native-config  -> exposes values to JS via `Config` (src/config/env.ts)
#   - dotenv.gradle         -> exposes values to Android Gradle (Maps manifest key)
#
# NOTE: A native rebuild is required after changing any value here, because
# these are inlined at build time (they are not read at runtime).

# Core engine REST API base URL (no trailing slash). Leave empty to run in mock mode.
API_BASE_URL=

# Core engine WebSocket endpoint (real-time features).
WS_ENDPOINT=

# Google Maps Platform API key (Places API New, Geocoding, Directions, Android Maps SDK).
GOOGLE_MAPS_API_KEY=
