# PickUp Driver — environment configuration
# Consumed at build time by react-native-config (JS) and dotenv.gradle (Android).
# This file holds real values and is git-ignored. See .env.example for the template.

# Core engine REST API base URL (no trailing slash)
API_BASE_URL=https://pickup-backend-engine-v2.onrender.com

# Core engine WebSocket endpoint (real-time features)
WS_ENDPOINT=wss://pickup-backend-engine-v2.onrender.com

# Google Maps Platform API key (Places API New, Geocoding, Directions, Android Maps SDK)
GOOGLE_MAPS_API_KEY=AIzaSyCqXIz_od_lQznfIxw01a5cGIWHZvJG4r8

# Payments + driver wallet backend (raj_backend) base URL, no trailing slash.
# Release builds only accept https://. Development builds also accept http:// so a backend on
# your laptop can be used:
#   - phone over USB: http://localhost:3000, after running `adb reverse tcp:3000 tcp:3000`
#   - Android emulator: http://10.0.2.2:3000
#   - phone on the same Wi-Fi: http://<laptop-LAN-IP>:3000 (allow port 3000 in the firewall)
# Leave empty to disable recharges (development builds then show sample wallet data).
PAYMENTS_API_BASE_URL=
