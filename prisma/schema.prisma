// MultipleRide backend: payments, driver wallet, driver earnings and weekly payouts.
//
// Source of truth: PickUp_Payment_Wallet_Industry_Grade_DB_Queries.pdf (PW), identity columns
// from M3 (users, drivers), payment-scoped subsets of M5 (bookings) and M6 (trips), and the
// approved V1 business rules (docs/OPEN_DECISIONS.md section F). See
// docs/ARCHITECTURE_TRACEABILITY.md.
//
// Rules enforced here and in the migration SQL:
//   - Money is always BIGINT paise. Never floats.
//   - PostgreSQL is the financial source of truth.
//   - The wallet ledger is append-only (trigger blocks UPDATE/DELETE).
//   - Customer payment, merchant settlement, driver earning (payable or not), driver payout and
//     driver wallet are separate records. None of them is ever derived from, or stored in,
//     another one's balance.
// CHECK constraints and triggers live in prisma/migrations/*/migration.sql because the Prisma
// schema language cannot express them.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  DRIVER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

/// M3 approval lifecycle (OPEN_DECISIONS D-05).
enum DriverApprovalStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED

  @@map("driver_approval_status")
}

/// PW: ACTIVE, LOW_BALANCE, BLOCKED.
enum WalletStatus {
  ACTIVE
  LOW_BALANCE
  BLOCKED

  @@map("wallet_status")
}

/// PW ledger entry types.
enum WalletEntryType {
  TOPUP
  CASH_RIDE_FEE
  REFUND_REVERSAL
  ADJUSTMENT

  @@map("wallet_entry_type")
}

enum LedgerDirection {
  CREDIT
  DEBIT

  @@map("ledger_direction")
}

/// Ledger rows are immutable, so only final POSTED rows are ever written.
enum TransactionStatus {
  POSTED

  @@map("transaction_status")
}

/// PW values plus FAILED and REFUNDED (OPEN_DECISIONS D-10).
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED

  @@map("payment_status")
}

/// D-01 option B: intent-level booking states. Execution detail lives on trips.status.
enum BookingStatus {
  CREATED
  SEARCHING_DRIVER
  DRIVER_ASSIGNED
  COMPLETED
  CANCELLED

  @@map("booking_status")
}

/// D-06: PW/MP payment methods. PREPAID_UPI covers every Razorpay Checkout method. How a
/// PAY_AT_* booking was actually paid (CASH or ONLINE_QR) is recorded on payment_collections.
enum BookingPaymentMethod {
  PREPAID_UPI
  PAY_AT_PICKUP
  PAY_AT_DELIVERY

  @@map("booking_payment_method")
}

/// How a booking's money is modelled (docs/PAYMENT_FLOW_FINAL_REVIEW.md, section K).
enum BookingPaymentModel {
  /// Registered before fare quotes existed (engine-sent fare, no stops). These bookings keep the
  /// booking-level rules they were created under; nothing is backfilled into them. Kept until
  /// every environment has no unfinished legacy booking (open decision L-22).
  LEGACY_BOOKING_LEVEL
  /// Priced from a redeemed fare quote, with one frozen stop row per drop. Every new booking.
  QUOTE_PER_STOP

  @@map("booking_payment_model")
}

/// A drop of a QUOTE_PER_STOP booking. The lifecycle (who moves a stop, and when) is enabled in a
/// later migration; until then every stop stays PENDING (the update guard refuses changes).
enum BookingStopStatus {
  PENDING
  ARRIVED
  PAYMENT_CONFIRMED
  DELIVERED
  DELIVERY_FAILED
  UNDELIVERED
  CANCELLED

  @@map("booking_stop_status")
}

/// D-10. The name differs from payment_status, which belongs to the payments table.
enum BookingPaymentStatus {
  UNPAID
  /// Pay at delivery, priced per drop: some but not all drops are paid (payment flow Phase 4).
  PARTIALLY_PAID
  PAID
  /// A refund of the booking's money is requested and not finished (payment flow Phase 6).
  REFUND_PENDING
  REFUNDED
  /// Some, but not all, of the money collected for the booking was refunded (payment flow Phase 6).
  PARTIALLY_REFUNDED

  @@map("booking_payment_status")
}

/// M6 lifecycle from assignment onwards (D-02 option A), plus CANCELLED.
enum TripStatus {
  DRIVER_ASSIGNED
  DRIVER_ARRIVED
  PICKUP_VERIFIED
  IN_TRANSIT
  DROP_PROGRESS
  DELIVERED
  PAYMENT_CONFIRMED
  COMPLETED
  CANCELLED

  @@map("trip_status")
}

/// Who received the customer's money for a trip.
enum EarningSettlement {
  /// Paid online to Nikhil Enterprises through Razorpay; the net share is paid out weekly.
  ONLINE
  /// Paid in cash to the driver; the platform fee was debited from the driver wallet.
  CASH
  /// Paid drop by drop, partly in cash and partly online (payment flow Phase 4). Its collections
  /// are listed in earning_collections; paying out its online part is payment flow Phase 5.
  MIXED

  @@map("earning_settlement")
}

enum EarningStatus {
  /// ONLINE earning whose customer payment was captured, but Razorpay has not yet confirmed the
  /// merchant settlement to Nikhil Enterprises' bank account. Never paid out in this state.
  AWAITING_SETTLEMENT
  /// ONLINE earning whose customer payment is settled: waiting for the next weekly payout.
  PAYABLE
  /// Excluded from payouts until an admin releases it (dispute, reversed payout, manual hold).
  ON_HOLD
  /// Included in a payout that has not finished yet.
  IN_PAYOUT
  /// The payout that carried it was processed by the provider.
  PAID
  /// CASH earning: the driver already holds the money; nothing is owed.
  SETTLED_IN_CASH

  @@map("earning_status")
}

enum BankAccountStatus {
  /// Submitted by the driver; bank validation and admin approval pending. No payouts.
  PENDING_VERIFICATION
  /// Validated by the bank and approved by an admin. The only status that receives payouts.
  VERIFIED
  /// Refused by an admin. Final.
  REJECTED
  /// No payouts: replaced by a newer account, a payout to it was reversed, or an admin stopped it.
  SUSPENDED

  @@map("bank_account_status")
}

enum PayoutBatchStatus {
  PREPARED
  EXECUTING
  COMPLETED

  @@map("payout_batch_status")
}

enum PayoutStatus {
  /// Created with its items; not sent to the provider yet.
  PREPARED
  /// Claimed by an executor; the provider call may or may not have happened.
  SUBMITTING
  /// Accepted by the provider (queued, pending or processing).
  SUBMITTED
  PROCESSED
  FAILED
  REVERSED

  @@map("payout_status")
}

enum PayoutItemStatus {
  INCLUDED
  PAID
  /// The payout failed; the earning went back to PAYABLE for a later payout.
  RELEASED
  /// The payout was reversed by the bank; the earning is ON_HOLD for review.
  REVERSED

  @@map("payout_item_status")
}

/// Base identity (M3 users). One row per phone number.
model User {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// E.164 format, e.g. +919876543210.
  phone     String     @unique(map: "uq_users_phone") @db.VarChar(20)
  role      UserRole
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  authIdentities             AuthIdentity[]
  driver                     Driver?                   @relation("DriverUser")
  customer                   Customer?
  approvedDrivers            Driver[]                  @relation("DriverApprovedBy")
  payments                   Payment[]
  performedLedgerEntries     DriverWalletTransaction[]
  adminActions               AdminAction[]
  createdFeeRules            FeeRule[]                 @relation("FeeRuleCreatedBy")
  deactivatedFeeRules        FeeRule[]                 @relation("FeeRuleDeactivatedBy")
  heldEarnings               DriverEarning[]           @relation("EarningHeldBy")
  verifiedBankAccounts       DriverBankAccount[]       @relation("BankAccountVerifiedBy")
  bankAccountStatusChanges   DriverBankAccount[]       @relation("BankAccountStatusChangedBy")
  createdPayoutBatches       PayoutBatch[]             @relation("PayoutBatchCreatedBy")
  bankValidationRequests     BankAccountVerification[] @relation("BankValidationRequestedBy")
  createdPricingVersions     PricingVersion[]          @relation("PricingVersionCreatedBy")
  deactivatedPricingVersions PricingVersion[]          @relation("PricingVersionDeactivatedBy")
  resolvedBookingStops       BookingStop[]             @relation("BookingStopResolvedBy")
  requestedRefunds           PaymentRefund[]           @relation("RefundRequestedBy")
  cancelledRefunds           PaymentRefund[]           @relation("RefundCancelledBy")
  requestedReconciliations   ReconciliationRun[]       @relation("ReconciliationRunRequestedBy")
  resolvedFindings           ReconciliationFinding[]   @relation("FindingResolvedBy")

  @@map("users")
}

/// Links an external identity (Firebase UID today) to a user.
model AuthIdentity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Identity provider name, e.g. "firebase".
  provider  String   @db.VarChar(30)
  /// Provider subject (Firebase UID).
  subject   String   @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, subject], map: "uq_auth_identities_provider_subject")
  @@index([userId], map: "idx_auth_identities_user")
  @@map("auth_identities")
}

/// Operational driver profile (M3 drivers, minimal subset for this slice).
model Driver {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String               @unique(map: "uq_drivers_user") @map("user_id") @db.Uuid
  approvalStatus   DriverApprovalStatus @default(PENDING) @map("approval_status")
  approvedAt       DateTime?            @map("approved_at") @db.Timestamptz(6)
  approvedByUserId String?              @map("approved_by_user_id") @db.Uuid
  /// Name on the driver's approved KYC documents. Set by ops tooling (never by the API role) and
  /// compared with the account holder name the bank reports during bank-account validation.
  legalName        String?              @map("legal_name") @db.VarChar(120)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                       @relation("DriverUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy   User?                      @relation("DriverApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  wallet       DriverWallet?
  trips        Trip[]
  collections  PaymentCollection[]
  earnings     DriverEarning[]
  bankAccounts DriverBankAccount[]
  bankChanges  BankAccountChangeRequest[]
  payouts      DriverPayout[]

  @@map("drivers")
}

/// PW 1.1: one wallet per driver. balance_paise is a cached balance; the ledger is the audit trail.
model DriverWallet {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId     String       @unique(map: "uq_driver_wallets_driver") @map("driver_id") @db.Uuid
  balancePaise BigInt       @default(0) @map("balance_paise")
  status       WalletStatus @default(ACTIVE)
  version      BigInt       @default(0)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  driver       Driver                    @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions DriverWalletTransaction[]

  @@index([status], map: "idx_driver_wallets_status")
  @@map("driver_wallets")
}

/// PW 1.2: append-only wallet ledger. amount_paise is always positive; direction decides credit/debit.
model DriverWalletTransaction {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId          String            @map("wallet_id") @db.Uuid
  type              WalletEntryType
  direction         LedgerDirection
  amountPaise       BigInt            @map("amount_paise")
  balanceAfterPaise BigInt            @map("balance_after_paise")
  /// driver_wallets.version produced by this entry (1, 2, 3, ...). Unique per wallet, so two
  /// entries can never be applied on top of the same balance, and it orders the ledger exactly.
  walletVersion     BigInt            @map("wallet_version")
  status            TransactionStatus @default(POSTED)
  referenceType     String            @map("reference_type") @db.VarChar(40)
  referenceId       String            @map("reference_id") @db.VarChar(100)
  idempotencyKey    String            @unique(map: "uq_wallet_tx_idempotency_key") @map("idempotency_key") @db.VarChar(150)
  provider          String?           @db.VarChar(40)
  providerOrderId   String?           @map("provider_order_id") @db.VarChar(100)
  providerPaymentId String?           @map("provider_payment_id") @db.VarChar(100)
  providerEventId   String?           @map("provider_event_id") @db.VarChar(150)
  performedByUserId String?           @map("performed_by_user_id") @db.Uuid
  reason            String?
  metadata          Json              @default("{}")
  /// clock_timestamp() (not now()) so entries are stamped when they are applied under the wallet
  /// lock, not when their transaction started.
  createdAt         DateTime          @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)

  wallet      DriverWallet       @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  performedBy User?              @relation(fields: [performedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  collection  PaymentCollection?
  /// The cash return whose platform fee this REFUND_REVERSAL credit gives back.
  refund      PaymentRefund?

  @@unique([walletId, walletVersion], map: "uq_wallet_tx_wallet_version")
  @@unique([provider, providerEventId], map: "uq_wallet_tx_provider_event")
  @@unique([provider, providerPaymentId], map: "uq_wallet_tx_topup_provider_payment", where: raw("((type = 'TOPUP'::wallet_entry_type) AND (provider_payment_id IS NOT NULL))"))
  @@index([walletId, createdAt(sort: Desc)], map: "idx_wallet_tx_wallet_created")
  @@index([referenceType, referenceId], map: "idx_wallet_tx_reference")
  @@map("driver_wallet_transactions")
}

/// PW 1.3: Razorpay payment records. One row per Razorpay order.
model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Set for purpose BOOKING (customer prepaid payment), NULL for wallet top-ups (CHECKs).
  bookingId         String?       @map("booking_id") @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  /// BOOKING or DRIVER_WALLET_TOPUP (CHECK constraint in SQL).
  purpose           String        @db.VarChar(30)
  provider          String        @default("RAZORPAY") @db.VarChar(40)
  razorpayOrderId   String?       @unique(map: "uq_payments_razorpay_order") @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId String?       @unique(map: "uq_payments_razorpay_payment") @map("razorpay_payment_id") @db.VarChar(100)
  amountPaise       BigInt        @map("amount_paise")
  status            PaymentStatus @default(PENDING)
  /// Method reported by Razorpay once paid (UPI, CARD, ...).
  paymentMethod     String?       @map("payment_method") @db.VarChar(40)
  currency          String        @default("INR") @db.Char(3)
  /// Client Idempotency-Key, unique per user, so retries never create a second order.
  idempotencyKey    String        @map("idempotency_key") @db.VarChar(150)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  booking            Booking?            @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  events             PaymentEvent[]
  earning            DriverEarning?
  settlement         PaymentSettlement?
  settlementFindings SettlementFinding[]
  refunds            PaymentRefund[]

  @@unique([userId, idempotencyKey], map: "uq_payments_user_idempotency")
  // At most one live payment per booking, so a booking can never be charged twice. A FAILED
  // payment (its order was never created) does not block a new attempt.
  @@unique([bookingId], map: "uq_payments_booking_active", where: raw("(((purpose)::text = 'BOOKING'::text) AND (status <> 'FAILED'::payment_status))"))
  @@index([status, createdAt], map: "idx_payments_status_created")
  @@index([userId, createdAt(sort: Desc)], map: "idx_payments_user_created")
  @@index([bookingId], map: "idx_payments_booking")
  @@map("payments")
}

/// PW 1.4: verified provider webhook events. event_id is the database-level idempotency guard.
/// Only signature-verified events are stored (see migration CHECK), so a forged request can never
/// reserve an event id ahead of the genuine event.
model PaymentEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId         String    @unique(map: "uq_payment_events_event_id") @map("event_id") @db.VarChar(150)
  eventType       String    @map("event_type") @db.VarChar(100)
  provider        String    @default("RAZORPAY") @db.VarChar(40)
  payload         Json
  signatureValid  Boolean   @map("signature_valid")
  /// Payment this event resolved to, when it matched one of ours.
  paymentId       String?   @map("payment_id") @db.Uuid
  /// Processing result, e.g. APPLIED, ALREADY_APPLIED, IGNORED, AMOUNT_MISMATCH.
  outcome         String?   @db.VarChar(40)
  attempts        Int       @default(0)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  processingError String?   @map("processing_error")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([createdAt], map: "idx_payment_events_unprocessed", where: raw("(processed_at IS NULL)"))
  @@index([paymentId], map: "idx_payment_events_payment")
  @@map("payment_events")
}

/// Customer profile (M5 ER: customers.user_id). Minimal until M2 is supplied (D-09).
model Customer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique(map: "uq_customers_user") @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookings   Booking[]
  fareQuotes FareQuote[]

  @@map("customers")
}

/// Payment-scoped subset of M5 bookings. The trip engine registers each booking (server to
/// server) when the customer confirms it, from a fare quote the Fare module priced. The booking
/// freezes the quote's amounts (the monetary snapshot); nothing changes them afterwards.
model Booking {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The trip engine's booking id. Registration is idempotent on it.
  externalRef        String               @unique(map: "uq_bookings_external_ref") @map("external_ref") @db.VarChar(100)
  customerId         String               @map("customer_id") @db.Uuid
  /// Vehicle category code. QUOTE_PER_STOP: copied from the quote (trigger). Selects
  /// category-specific fee rules.
  vehicleCategory    String?              @map("vehicle_category") @db.VarChar(50)
  status             BookingStatus        @default(CREATED)
  /// The amount payable at confirmation, in paise (fare + tax).
  fareEstimateMinor  BigInt               @map("fare_estimate_minor")
  /// Always equal to fare_estimate_minor (CHECK): the payable amount never changes after
  /// confirmation. QUOTE_PER_STOP: the quote's payable amount (trigger).
  finalFareMinor     BigInt               @map("final_fare_minor")
  paymentMethod      BookingPaymentMethod @map("payment_method")
  paymentStatus      BookingPaymentStatus @default(UNPAID) @map("payment_status")
  /// Fee rule in effect at confirmation, pinned so later rule versions never change this booking.
  feeRuleId          String               @map("fee_rule_id") @db.Uuid
  /// Which rules this booking follows. Set at registration, immutable (trigger).
  paymentModel       BookingPaymentModel  @map("payment_model")
  /// QUOTE_PER_STOP only: the fare quote redeemed for this booking (one booking per quote).
  fareQuoteId        String?              @unique(map: "uq_bookings_fare_quote") @map("fare_quote_id") @db.Uuid
  /// QUOTE_PER_STOP only: the pricing version that priced the quote.
  pricingVersionId   String?              @map("pricing_version_id") @db.Uuid
  /// QUOTE_PER_STOP only: the fare excluding tax, in paise.
  farePaise          BigInt?              @map("fare_paise")
  /// QUOTE_PER_STOP only: tax in paise. Always 0 until a tax rule is approved (CHECK; L-2).
  taxPaise           BigInt?              @map("tax_paise")
  /// QUOTE_PER_STOP only: the platform fee under the pinned rule, frozen at registration and
  /// split across the stops. LEGACY rows compute it from the pinned rule, as before.
  platformFeePaise   BigInt?              @map("platform_fee_paise")
  confirmedAt        DateTime             @map("confirmed_at") @db.Timestamptz(6)
  completedAt        DateTime?            @map("completed_at") @db.Timestamptz(6)
  cancelledAt        DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?              @map("cancellation_reason") @db.VarChar(200)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  feeRule            FeeRule             @relation(fields: [feeRuleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fareQuote          FareQuote?          @relation(fields: [fareQuoteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pricingVersion     PricingVersion?     @relation(fields: [pricingVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stops              BookingStop[]
  trip               Trip?
  payments           Payment[]
  collections        PaymentCollection[]
  earning            DriverEarning?
  earningCollections EarningCollection[]
  disputes           PaymentDispute[]
  settlements        PaymentSettlement[]
  settlementFindings SettlementFinding[]
  refunds            PaymentRefund[]

  @@index([customerId, createdAt(sort: Desc)], map: "idx_bookings_customer_created")
  @@index([status, createdAt], map: "idx_bookings_status_created")
  @@index([feeRuleId], map: "idx_bookings_fee_rule")
  @@index([pricingVersionId], map: "idx_bookings_pricing_version")
  @@map("bookings")
}

/// One drop of a QUOTE_PER_STOP booking: the amounts frozen from its quoted drop, and this drop's
/// share of the platform fee. Amounts are immutable; the stops add up exactly to the booking
/// (deferred trigger). A legacy booking has no stops.
model BookingStop {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId             String            @map("booking_id") @db.Uuid
  /// The quoted drop these amounts were copied from (trigger checks they are identical).
  fareQuoteStopId       String            @unique(map: "uq_booking_stops_quote_stop") @map("fare_quote_stop_id") @db.Uuid
  /// 1-based delivery order, the quoted drop's sequence.
  sequence              Int               @db.SmallInt
  farePaise             BigInt            @map("fare_paise")
  taxPaise              BigInt            @map("tax_paise")
  /// What is collected for this drop when the receivers pay: fare + tax.
  payablePaise          BigInt            @map("payable_paise")
  /// This drop's share of the booking's platform fee, by largest remainder: the shares add up
  /// exactly to the booking's fee.
  platformFeeSharePaise BigInt            @map("platform_fee_share_paise")
  status                BookingStopStatus @default(PENDING)
  /// Lifecycle facts, recorded by the stop lifecycle (payment flow Phase 3). CHECKs tie each
  /// status to its facts; a PENDING stop has none of them.
  arrivedAt             DateTime?         @map("arrived_at") @db.Timestamptz(6)
  paymentConfirmedAt    DateTime?         @map("payment_confirmed_at") @db.Timestamptz(6)
  deliveredAt           DateTime?         @map("delivered_at") @db.Timestamptz(6)
  /// The last failed delivery attempt, with its reason (both or neither).
  failedAt              DateTime?         @map("failed_at") @db.Timestamptz(6)
  failureReason         String?           @map("failure_reason") @db.VarChar(200)
  cancelledAt           DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  /// An admin's resolution of a failed delivery: who, when and why, recorded whole.
  resolvedAt            DateTime?         @map("resolved_at") @db.Timestamptz(6)
  resolvedByUserId      String?           @map("resolved_by_user_id") @db.Uuid
  resolutionReason      String?           @map("resolution_reason") @db.VarChar(200)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking       Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fareQuoteStop FareQuoteStop       @relation(fields: [fareQuoteStopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy    User?               @relation("BookingStopResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  collections   PaymentCollection[]
  refunds       PaymentRefund[]

  @@unique([bookingId, sequence], map: "uq_booking_stops_sequence")
  /// Target of the composite foreign key that ties a stop's collections to the same booking.
  @@unique([bookingId, id], map: "uq_booking_stops_booking_id")
  /// At most one current (ARRIVED or PAYMENT_CONFIRMED) stop per booking.
  @@unique([bookingId], map: "uq_booking_stops_current", where: raw("(status = ANY (ARRAY['ARRIVED'::booking_stop_status, 'PAYMENT_CONFIRMED'::booking_stop_status]))"))
  @@map("booking_stops")
}

/// Payment-scoped subset of M6 trips: one trip per booking, created at assignment. vehicle_id
/// and current_stop_id are owned by the trip engine for now (documented deviation).
model Trip {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId          String     @unique(map: "uq_trips_booking") @map("booking_id") @db.Uuid
  driverId           String     @map("driver_id") @db.Uuid
  status             TripStatus @default(DRIVER_ASSIGNED)
  assignedAt         DateTime   @default(now()) @map("assigned_at") @db.Timestamptz(6)
  arrivedAt          DateTime?  @map("arrived_at") @db.Timestamptz(6)
  pickupVerifiedAt   DateTime?  @map("pickup_verified_at") @db.Timestamptz(6)
  startedAt          DateTime?  @map("started_at") @db.Timestamptz(6)
  deliveredAt        DateTime?  @map("delivered_at") @db.Timestamptz(6)
  paymentConfirmedAt DateTime?  @map("payment_confirmed_at") @db.Timestamptz(6)
  completedAt        DateTime?  @map("completed_at") @db.Timestamptz(6)
  cancelledAt        DateTime?  @map("cancelled_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking     Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  driver      Driver              @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  collections PaymentCollection[]
  earning     DriverEarning?

  @@index([driverId, status], map: "idx_trips_driver_status")
  @@index([status], map: "idx_trips_status")
  @@map("trips")
}

/// PW 1.6: versioned platform-fee rules. Amounts, type and window start are never edited and
/// rows are never deleted (triggers). A new version closes the previous one via effective_to.
model FeeRule {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Vehicle category code, or NULL for every category.
  category            String?   @db.VarChar(50)
  /// FIXED (value in paise) or PERCENTAGE (value in percent of the fare). CHECK in SQL.
  ruleType            String    @map("rule_type") @db.VarChar(20)
  value               Decimal   @db.Decimal(12, 4)
  /// Always HALF_UP (CHECK, OPEN_DECISIONS D-44): a PERCENTAGE fee is rounded half up to whole
  /// paise by src/common/money.ts. Kept on every rule so each version records how it computed.
  roundingMode        String    @default("HALF_UP") @map("rounding_mode") @db.VarChar(10)
  effectiveFrom       DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo         DateTime? @map("effective_to") @db.Timestamptz(6)
  active              Boolean   @default(true)
  /// Why this rule exists (approval reference). Required.
  reason              String
  /// Admin who created it; NULL when created with the ops CLI.
  createdByUserId     String?   @map("created_by_user_id") @db.Uuid
  deactivatedAt       DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivatedByUserId String?   @map("deactivated_by_user_id") @db.Uuid
  deactivationReason  String?   @map("deactivation_reason")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy     User?               @relation("FeeRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deactivatedBy User?               @relation("FeeRuleDeactivatedBy", fields: [deactivatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookings      Booking[]
  collections   PaymentCollection[]
  earnings      DriverEarning[]

  @@index([category, active, effectiveFrom(sort: Desc)], map: "idx_fee_rules_lookup")
  @@map("fee_rules")
}

/// PW 1.5: money collected for a PAY_AT_PICKUP / PAY_AT_DELIVERY booking, either as cash or
/// through a booking-linked Razorpay payment link / QR code. Never a personal UPI id.
model PaymentCollection {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId           String    @map("booking_id") @db.Uuid
  /// The drop this collection is for: only for a PAY_AT_DELIVERY booking priced per drop
  /// (per-drop collection, payment flow Phase 4). NULL for pickup and historical bookings.
  bookingStopId       String?   @map("booking_stop_id") @db.Uuid
  tripId              String    @map("trip_id") @db.Uuid
  /// PICKUP or DELIVERY (CHECK).
  stage               String    @db.VarChar(20)
  /// CASH or ONLINE_QR (CHECK).
  method              String    @db.VarChar(20)
  amountPaise         BigInt    @map("amount_paise")
  /// Sum of this collection's completed refunds (payment flow Phase 6). Kept by a trigger from
  /// payment_refunds; the API role cannot write it.
  refundedPaise       BigInt    @default(0) @map("refunded_paise")
  collectedByDriverId String    @map("collected_by_driver_id") @db.Uuid
  /// PENDING, COMPLETED, FAILED or REVERSED (CHECK).
  status              String    @default("COMPLETED") @db.VarChar(20)
  provider            String?   @db.VarChar(40)
  /// ONLINE_QR only: PAYMENT_LINK or QR_CODE (CHECK).
  providerProduct     String?   @map("provider_product") @db.VarChar(30)
  /// ONLINE_QR only: the provider object shown to the customer (plink_... or qr_...).
  providerReferenceId String?   @map("provider_reference_id") @db.VarChar(100)
  /// ONLINE_QR only: what the driver app renders (payment link URL or QR image URL).
  providerLinkUrl     String?   @map("provider_link_url") @db.VarChar(500)
  providerOrderId     String?   @map("provider_order_id") @db.VarChar(100)
  providerPaymentId   String?   @map("provider_payment_id") @db.VarChar(100)
  /// Method reported by the provider once paid (UPI, CARD, ...).
  paymentMethod       String?   @map("payment_method") @db.VarChar(40)
  /// CASH only: platform fee debited from the driver wallet for this collection.
  platformFeePaise    BigInt?   @map("platform_fee_paise")
  feeRuleId           String?   @map("fee_rule_id") @db.Uuid
  /// CASH only: the CASH_RIDE_FEE ledger entry (NULL when the fee is zero).
  walletTransactionId String?   @unique(map: "uq_collections_wallet_tx") @map("wallet_transaction_id") @db.Uuid
  idempotencyKey      String    @unique(map: "uq_collections_idempotency_key") @map("idempotency_key") @db.VarChar(150)
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  failureReason       String?   @map("failure_reason") @db.VarChar(100)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking            Booking                  @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite key: a collection can only name a stop of its own booking.
  bookingStop        BookingStop?             @relation(fields: [bookingId, bookingStopId], references: [bookingId, id], onDelete: Restrict, onUpdate: Restrict)
  trip               Trip                     @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  collectedBy        Driver                   @relation(fields: [collectedByDriverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  feeRule            FeeRule?                 @relation(fields: [feeRuleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  walletTransaction  DriverWalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  earning            DriverEarning?
  /// The earning this collection funds, once the trip completed.
  earningLink        EarningCollection?
  settlement         PaymentSettlement?
  settlementFindings SettlementFinding[]
  refunds            PaymentRefund[]

  @@unique([provider, providerPaymentId], map: "uq_collection_provider_payment", where: raw("(provider_payment_id IS NOT NULL)"))
  @@unique([provider, providerReferenceId], map: "uq_collection_provider_reference", where: raw("(provider_reference_id IS NOT NULL)"))
  // One live collection per obligation, so nothing is ever collected twice: per booking for
  // pickup and historical bookings, per drop for a pay-at-delivery booking priced per drop. A
  // booking's collections are all of one kind (insert guard).
  @@unique([bookingId], map: "uq_collection_booking_level_active", where: raw("((booking_stop_id IS NULL) AND ((status)::text = ANY (ARRAY[('PENDING'::character varying)::text, ('COMPLETED'::character varying)::text])))"))
  @@unique([bookingStopId], map: "uq_collection_stop_active", where: raw("((booking_stop_id IS NOT NULL) AND ((status)::text = ANY (ARRAY[('PENDING'::character varying)::text, ('COMPLETED'::character varying)::text])))"))
  @@index([bookingId], map: "idx_collections_booking")
  @@index([tripId], map: "idx_collections_trip")
  @@index([status, createdAt], map: "idx_collections_status_created")
  @@map("payment_collections")
}

/// What the driver earned on one completed trip: gross fare, platform fee, other deductions, TDS
/// and the net share. Separate from the wallet. The wallet balance is never the driver's earnings.
/// Amounts are computed by the backend only and are immutable once recorded (trigger).
model DriverEarning {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId            String            @unique(map: "uq_earnings_booking") @map("booking_id") @db.Uuid
  tripId               String            @unique(map: "uq_earnings_trip") @map("trip_id") @db.Uuid
  driverId             String            @map("driver_id") @db.Uuid
  settlement           EarningSettlement
  /// The confirmed fare the customer paid, in paise.
  grossAmountPaise     BigInt            @map("gross_amount_paise")
  platformFeePaise     BigInt            @map("platform_fee_paise")
  /// Approved deductions other than the platform fee. Always 0 in V1 (none is approved).
  otherDeductionsPaise BigInt            @default(0) @map("other_deductions_paise")
  /// Tax deducted at source. Always 0 while the TDS policy is DISABLED (OPEN_DECISIONS D-57).
  tdsAmountPaise       BigInt            @default(0) @map("tds_amount_paise")
  /// gross - fee - other deductions - TDS (CHECK). ONLINE: owed to the driver by payout. CASH:
  /// already kept by the driver. MIXED: the cash part kept, the online part owed.
  netAmountPaise       BigInt            @map("net_amount_paise")
  /// Collected in cash: already in the driver's hand (payment flow Phase 5). With the online
  /// part it adds up to the gross amount (CHECK).
  cashCollectedPaise   BigInt            @map("cash_collected_paise")
  /// Collected online (prepaid or QR): received by Nikhil Enterprises.
  onlineCollectedPaise BigInt            @map("online_collected_paise")
  /// Platform fee on the cash part (debited from the wallet). With the online fee it adds up to
  /// the platform fee (CHECK).
  cashFeePaise         BigInt            @map("cash_fee_paise")
  /// Platform fee on the online part (kept from the payout).
  onlineFeePaise       BigInt            @map("online_fee_paise")
  /// What a payout carries for this earning (CHECK): 0 for CASH, the net for ONLINE, the online
  /// part net of its fee for MIXED. Immutable; a payout item must equal it.
  payoutAmountPaise    BigInt            @map("payout_amount_paise")
  /// DISABLED or TAX_RULE (CHECK): the TDS policy snapshotted when the earning was recorded.
  tdsPolicy            String            @default("DISABLED") @map("tds_policy") @db.VarChar(20)
  /// The tax rule version applied (TAX_RULE policy only).
  taxRuleId            String?           @map("tax_rule_id") @db.Uuid
  feeRuleId            String            @map("fee_rule_id") @db.Uuid
  /// The customer payment this came from: a prepaid BOOKING payment ...
  paymentId            String?           @unique(map: "uq_earnings_payment") @map("payment_id") @db.Uuid
  /// ... or a pickup/delivery collection (cash or QR). At most one is set (CHECK). An earning
  /// funded by several collections (a booking paid drop by drop) has neither: its collections are
  /// in collectionLinks (deferred trigger).
  collectionId         String?           @unique(map: "uq_earnings_collection") @map("collection_id") @db.Uuid
  status               EarningStatus
  /// ONLINE only: Razorpay's merchant settlement of the customer payment. Required before the
  /// earning can be PAYABLE (CHECK); set once (trigger).
  paymentSettlementId  String?           @unique(map: "uq_earnings_payment_settlement") @map("payment_settlement_id") @db.Uuid
  /// ONLINE only: when the earning became eligible for a payout, i.e. the later of the trip
  /// completion and the merchant settlement. Set once, when it first becomes PAYABLE.
  payableAt            DateTime?         @map("payable_at") @db.Timestamptz(6)
  holdReason           String?           @map("hold_reason") @db.VarChar(500)
  heldAt               DateTime?         @map("held_at") @db.Timestamptz(6)
  heldByUserId         String?           @map("held_by_user_id") @db.Uuid
  paidAt               DateTime?         @map("paid_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking           Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  trip              Trip                @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  driver            Driver              @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  feeRule           FeeRule             @relation(fields: [feeRuleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  taxRule           TaxRule?            @relation(fields: [taxRuleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment           Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  collection        PaymentCollection?  @relation(fields: [collectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  paymentSettlement PaymentSettlement?  @relation(fields: [paymentSettlementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  heldBy            User?               @relation("EarningHeldBy", fields: [heldByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payoutItems       PayoutItem[]
  /// Every collection that funds this earning, with its method, amount and fee share.
  collectionLinks   EarningCollection[]

  @@index([driverId, createdAt(sort: Desc)], map: "idx_earnings_driver_created")
  @@index([status, payableAt], map: "idx_earnings_status_payable")
  @@map("driver_earnings")
}

/// The collections that fund a driver earning (payment flow Phase 4): one row per collection,
/// with its method, amount and platform fee share, so the source of every amount is kept. A
/// collection funds at most one earning. Written with the earning, in its transaction; never
/// changed or deleted (triggers). The rows add up to the earning (deferred trigger).
model EarningCollection {
  collectionId     String   @id @map("collection_id") @db.Uuid
  earningId        String   @map("earning_id") @db.Uuid
  bookingId        String   @map("booking_id") @db.Uuid
  /// CASH or ONLINE_QR, as on the collection (CHECK).
  method           String   @db.VarChar(20)
  amountPaise      BigInt   @map("amount_paise")
  /// The platform fee on this amount: the fee debited for a cash collection, or the share of the
  /// fee owed on an online one (the drop's share, or the booking's fee).
  platformFeePaise BigInt   @map("platform_fee_paise")
  /// What this collection contributes to the earning: amount - platform fee (CHECK).
  netAmountPaise   BigInt   @map("net_amount_paise")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  collection PaymentCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  earning    DriverEarning     @relation(fields: [earningId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  booking    Booking           @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([earningId], map: "idx_earning_collections_earning")
  @@index([bookingId], map: "idx_earning_collections_booking")
  @@map("earning_collections")
}

/// Merchant settlement: Razorpay's confirmation that one customer payment reached Nikhil
/// Enterprises' bank account. Recorded from Razorpay's settlement reconciliation data (or the
/// non-production simulator), never inferred from the payment capture. Immutable (trigger). An
/// ONLINE earning becomes PAYABLE only once its customer payment has one of these.
model PaymentSettlement {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider             String   @default("RAZORPAY") @db.VarChar(40)
  /// pay_... of the settled customer payment.
  providerPaymentId    String   @map("provider_payment_id") @db.VarChar(100)
  /// setl_... of the Razorpay settlement that carried it.
  providerSettlementId String   @map("provider_settlement_id") @db.VarChar(100)
  /// Bank reference of the settlement transfer, when Razorpay reports one.
  settlementUtr        String?  @map("settlement_utr") @db.VarChar(100)
  /// When Razorpay settled the payment (provider time).
  settledAt            DateTime @map("settled_at") @db.Timestamptz(6)
  /// Payment amount reported in the settlement data. Equal to ours, or nothing is recorded.
  amountPaise          BigInt   @map("amount_paise")
  /// Razorpay's fee and GST on the payment, deducted from the settlement (the merchant's cost,
  /// never the driver's).
  feePaise             BigInt   @default(0) @map("fee_paise")
  taxPaise             BigInt   @default(0) @map("tax_paise")
  bookingId            String   @map("booking_id") @db.Uuid
  /// The prepaid booking payment that was settled ...
  paymentId            String?  @unique(map: "uq_settlements_payment") @map("payment_id") @db.Uuid
  /// ... or the online pickup/delivery collection. Exactly one is set (CHECK).
  collectionId         String?  @unique(map: "uq_settlements_collection") @map("collection_id") @db.Uuid
  /// RAZORPAY_RECON (settlement reconciliation API) or SIMULATED (non-production only). CHECK.
  source               String   @db.VarChar(20)
  /// The provider's reconciliation item fields used for the match, for audit.
  details              Json     @default("{}")
  createdAt            DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)

  booking    Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment    Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  collection PaymentCollection? @relation(fields: [collectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  earning    DriverEarning?

  @@unique([provider, providerPaymentId], map: "uq_settlements_provider_payment")
  @@index([bookingId], map: "idx_settlements_booking")
  @@index([providerSettlementId], map: "idx_settlements_provider_settlement")
  @@index([settledAt], map: "idx_settlements_settled_at")
  @@map("payment_settlements")
}

/// A settled payment from Razorpay settlement reconciliation that the backend could not match
/// (payment flow Phase 5): UNKNOWN_PAYMENT (none of ours) or AMOUNT_MISMATCH (ours, with another
/// amount). Never applied to an earning; listed for review. One row per payment, settlement and
/// kind; seeing it again only counts it (trigger). Never deleted.
model SettlementFinding {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider             String   @default("RAZORPAY") @db.VarChar(40)
  /// UNKNOWN_PAYMENT or AMOUNT_MISMATCH (CHECK).
  kind                 String   @db.VarChar(30)
  providerPaymentId    String   @map("provider_payment_id") @db.VarChar(100)
  providerSettlementId String   @map("provider_settlement_id") @db.VarChar(100)
  settledAt            DateTime @map("settled_at") @db.Timestamptz(6)
  /// What the settlement data reports.
  settledAmountPaise   BigInt   @map("settled_amount_paise")
  /// AMOUNT_MISMATCH: what our payment or collection was for.
  expectedAmountPaise  BigInt?  @map("expected_amount_paise")
  bookingId            String?  @map("booking_id") @db.Uuid
  paymentId            String?  @map("payment_id") @db.Uuid
  collectionId         String?  @map("collection_id") @db.Uuid
  /// RAZORPAY_RECON or SIMULATED (CHECK).
  source               String   @db.VarChar(20)
  occurrences          Int      @default(1)
  firstSeenAt          DateTime @default(dbgenerated("clock_timestamp()")) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt           DateTime @default(dbgenerated("clock_timestamp()")) @map("last_seen_at") @db.Timestamptz(6)

  booking    Booking?           @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment    Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  collection PaymentCollection? @relation(fields: [collectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, providerPaymentId, providerSettlementId, kind], map: "uq_settlement_findings_item")
  @@index([lastSeenAt], map: "idx_settlement_findings_last_seen")
  @@map("settlement_findings")
}

/// Versioned tax-deduction (TDS) rules. Deliberately empty: whether and how driver payouts are
/// subject to TDS waits for the CA (OPEN_DECISIONS D-57), and TDS_ENABLED=true is refused at
/// startup. Rows can only be added by ops tooling (the API role can read, never write), are never
/// edited except to close a version, and are never deleted (triggers).
model TaxRule {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Rule family, e.g. TDS_194C. CHECK format.
  code              String    @db.VarChar(40)
  version           Int
  /// EARNING (per trip earning) or PAYOUT (per payout). CHECK.
  appliesTo         String    @map("applies_to") @db.VarChar(20)
  /// Percent of the taxable amount (CHECK 0 <= rate < 100).
  ratePercent       Decimal   @map("rate_percent") @db.Decimal(7, 4)
  effectiveFrom     DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo       DateTime? @map("effective_to") @db.Timestamptz(6)
  /// The CA approval this version implements. Required.
  approvalReference String    @map("approval_reference")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  earnings DriverEarning[]
  payouts  DriverPayout[]

  @@unique([code, version], map: "uq_tax_rules_code_version")
  @@map("tax_rules")
}

/// Payout beneficiary. Only the last 4 digits of the account number are stored: the full number
/// goes straight to the payout provider, which returns a fund account id.
model DriverBankAccount {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId               String            @map("driver_id") @db.Uuid
  accountHolderName      String            @map("account_holder_name") @db.VarChar(120)
  ifsc                   String            @db.Char(11)
  accountNumberLast4     String            @map("account_number_last4") @db.Char(4)
  provider               String            @db.VarChar(40)
  providerContactId      String            @map("provider_contact_id") @db.VarChar(100)
  providerFundAccountId  String            @map("provider_fund_account_id") @db.VarChar(100)
  status                 BankAccountStatus @default(PENDING_VERIFICATION)
  verifiedAt             DateTime?         @map("verified_at") @db.Timestamptz(6)
  verifiedByUserId       String?           @map("verified_by_user_id") @db.Uuid
  /// The provider validation id (fav_...) the approval relied on.
  verificationReference  String?           @map("verification_reference") @db.VarChar(200)
  /// The completed, active bank validation an admin approved this account on. Required for
  /// VERIFIED (CHECK); reinstating a suspended account needs a newer one (trigger).
  approvedVerificationId String?           @unique(map: "uq_bank_accounts_approved_verification") @map("approved_verification_id") @db.Uuid
  /// The admin's explanation when the bank's registered name was not an exact KYC match.
  nameMatchResolution    String?           @map("name_match_resolution") @db.VarChar(500)
  /// Reason for REJECTED or SUSPENDED.
  statusReason           String?           @map("status_reason") @db.VarChar(500)
  statusChangedByUserId  String?           @map("status_changed_by_user_id") @db.Uuid
  /// The step-up verified change request that added this account. Required for every new
  /// account (trigger); NULL only for accounts added before step-up verification existed, which
  /// can never be approved.
  changeRequestId        String?           @unique(map: "uq_bank_accounts_change_request") @map("change_request_id") @db.Uuid
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  driver               Driver                    @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  verifiedBy           User?                     @relation("BankAccountVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  statusChangedBy      User?                     @relation("BankAccountStatusChangedBy", fields: [statusChangedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedVerification BankAccountVerification?  @relation("BankAccountApprovedVerification", fields: [approvedVerificationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changeRequest        BankAccountChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  verifications        BankAccountVerification[] @relation("BankAccountVerifications")
  payouts              DriverPayout[]

  // RazorpayX returns the existing fund account for identical details, so only live accounts
  // need a unique one (a driver may switch back to an earlier account).
  @@unique([provider, providerFundAccountId], map: "uq_bank_accounts_fund_account_live", where: raw("(status = ANY (ARRAY['PENDING_VERIFICATION'::bank_account_status, 'VERIFIED'::bank_account_status]))"))
  // One live (pending or verified) bank account per driver.
  @@unique([driverId], map: "uq_bank_accounts_driver_active", where: raw("(status = ANY (ARRAY['PENDING_VERIFICATION'::bank_account_status, 'VERIFIED'::bank_account_status]))"))
  @@index([driverId], map: "idx_bank_accounts_driver")
  @@index([status, createdAt], map: "idx_bank_accounts_status_created")
  @@map("driver_bank_accounts")
}

/// A driver's request to add or change the payout bank account (OPEN_DECISIONS D-61). The new
/// account is accepted only after a step-up: a phone OTP re-authentication that happened after
/// the request was created, proven by a fresh Firebase ID token (auth_time, phone_number). The
/// window (created_at, expires_at: 10 minutes) comes from the database clock (trigger).
///
///   PENDING_STEP_UP -> STEP_UP_VERIFIED -> COMPLETED (one transaction, with the new account)
///   PENDING_STEP_UP -> CANCELLED | EXPIRED
model BankAccountChangeRequest {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId         String    @map("driver_id") @db.Uuid
  /// PENDING_STEP_UP, STEP_UP_VERIFIED (never committed), COMPLETED, CANCELLED or EXPIRED.
  status           String    @default("PENDING_STEP_UP") @db.VarChar(20)
  /// FIREBASE_PHONE_REAUTH (CHECK).
  stepUpMethod     String    @default("FIREBASE_PHONE_REAUTH") @map("step_up_method") @db.VarChar(30)
  /// auth_time of the token that proved the step-up. Always after created_at (CHECK).
  stepUpAuthTime   DateTime? @map("step_up_auth_time") @db.Timestamptz(6)
  /// phone_number of that token: the driver's registered phone (trigger).
  stepUpPhone      String?   @map("step_up_phone") @db.VarChar(20)
  /// Set by the database when the step-up is accepted.
  stepUpVerifiedAt DateTime? @map("step_up_verified_at") @db.Timestamptz(6)
  /// CANCELLED only: DRIVER_CANCELLED or SUPERSEDED (CHECK).
  closeReason      String?   @map("close_reason") @db.VarChar(40)
  /// created_at + 10 minutes, set by the database. Can be brought forward, never extended.
  expiresAt        DateTime  @default(dbgenerated("(clock_timestamp() + '00:10:00'::interval)")) @map("expires_at") @db.Timestamptz(6)
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(6)
  /// Database clock at insert (the trigger overrides any value supplied).
  createdAt        DateTime  @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  driver      Driver             @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bankAccount DriverBankAccount?

  // At most one open request per driver.
  @@unique([driverId], map: "uq_bank_change_requests_driver_open", where: raw("((status)::text = ANY (ARRAY[('PENDING_STEP_UP'::character varying)::text, ('STEP_UP_VERIFIED'::character varying)::text]))"))
  @@index([driverId, createdAt(sort: Desc)], map: "idx_bank_change_requests_driver_created")
  @@map("bank_account_change_requests")
}

/// One bank-account validation through the payout provider (RazorpayX Fund Account Validation, a
/// penny drop): whether the account is active and the holder name the bank has on record. It is
/// evidence for an admin's decision; it never approves an account by itself.
model BankAccountVerification {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankAccountId        String    @map("bank_account_id") @db.Uuid
  provider             String    @db.VarChar(40)
  /// fav_... returned by the provider.
  providerValidationId String    @map("provider_validation_id") @db.VarChar(100)
  /// PENNY_DROP (CHECK).
  method               String    @db.VarChar(20)
  /// CREATED (result pending), COMPLETED or FAILED (CHECK). Final states are immutable.
  status               String    @default("CREATED") @db.VarChar(20)
  /// COMPLETED only: ACTIVE or INVALID, as reported by the bank.
  accountStatus        String?   @map("account_status") @db.VarChar(20)
  /// Account holder name registered with the bank, as returned by the provider.
  registeredName       String?   @map("registered_name") @db.VarChar(200)
  /// The provider's own name-match score (0-100), when it returns one.
  nameMatchScore       Int?      @map("name_match_score")
  /// Our comparison of registered_name with the driver's KYC name: MATCH, PARTIAL, MISMATCH or
  /// UNAVAILABLE (CHECK).
  nameMatchResult      String?   @map("name_match_result") @db.VarChar(20)
  /// The driver's KYC legal name used for the comparison.
  comparedName         String?   @map("compared_name") @db.VarChar(120)
  utr                  String?   @db.VarChar(100)
  failureReason        String?   @map("failure_reason") @db.VarChar(300)
  /// The admin who asked for this validation; NULL when the driver's submission started it.
  requestedByUserId    String?   @map("requested_by_user_id") @db.Uuid
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  bankAccount DriverBankAccount  @relation("BankAccountVerifications", fields: [bankAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy User?              @relation("BankValidationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedFor DriverBankAccount? @relation("BankAccountApprovedVerification")

  @@unique([provider, providerValidationId], map: "uq_bank_validations_provider_validation")
  @@index([bankAccountId, createdAt(sort: Desc)], map: "idx_bank_validations_account_created")
  @@index([status, createdAt], map: "idx_bank_validations_status_created")
  @@map("bank_account_verifications")
}

/// A weekly (or admin-triggered) payout run.
model PayoutBatch {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// schedule:<cycle> for the scheduler, admin:<user>:<Idempotency-Key> for admins.
  idempotencyKey   String            @unique(map: "uq_payout_batches_idempotency_key") @map("idempotency_key") @db.VarChar(150)
  /// ISO week of the cutoff in the payout timezone, e.g. 2026-W40.
  cycleKey         String            @map("cycle_key") @db.VarChar(20)
  /// SCHEDULE or ADMIN (CHECK).
  origin           String            @db.VarChar(20)
  /// Earnings that became payable at or before this instant are included.
  cutoffAt         DateTime          @map("cutoff_at") @db.Timestamptz(6)
  status           PayoutBatchStatus @default(PREPARED)
  payoutCount      Int               @default(0) @map("payout_count")
  totalAmountPaise BigInt            @default(0) @map("total_amount_paise")
  createdByUserId  String?           @map("created_by_user_id") @db.Uuid
  executedAt       DateTime?         @map("executed_at") @db.Timestamptz(6)
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User?          @relation("PayoutBatchCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payouts   DriverPayout[]

  @@index([createdAt(sort: Desc)], map: "idx_payout_batches_created")
  @@map("payout_batches")
}

/// One bank transfer to one driver within a batch. The id doubles as the provider idempotency
/// key and reference id, so a retried submission can never create a second transfer.
model DriverPayout {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId              String       @map("batch_id") @db.Uuid
  driverId             String       @map("driver_id") @db.Uuid
  bankAccountId        String       @map("bank_account_id") @db.Uuid
  /// Sum of the carried earnings' net amounts (checked at commit against the items).
  grossAmountPaise     BigInt       @map("gross_amount_paise")
  /// Tax deducted at source on this payout. 0 while the TDS policy is DISABLED.
  tdsAmountPaise       BigInt       @default(0) @map("tds_amount_paise")
  /// Approved payout-level deductions. Always 0 in V1.
  otherDeductionsPaise BigInt       @default(0) @map("other_deductions_paise")
  /// DISABLED or TAX_RULE (CHECK), snapshotted when the payout was prepared.
  tdsPolicy            String       @default("DISABLED") @map("tds_policy") @db.VarChar(20)
  taxRuleId            String?      @map("tax_rule_id") @db.Uuid
  /// What is transferred: gross - TDS - other deductions (CHECK).
  amountPaise          BigInt       @map("amount_paise")
  currency             String       @default("INR") @db.Char(3)
  /// IMPS, NEFT or RTGS, fixed when the payout is prepared (CHECK).
  mode                 String       @db.VarChar(10)
  status               PayoutStatus @default(PREPARED)
  provider             String       @db.VarChar(40)
  providerPayoutId     String?      @map("provider_payout_id") @db.VarChar(100)
  /// The provider's own status string, e.g. queued, processing, processed.
  providerStatus       String?      @map("provider_status") @db.VarChar(30)
  utr                  String?      @db.VarChar(100)
  failureReason        String?      @map("failure_reason") @db.VarChar(300)
  attempts             Int          @default(0)
  lastAttemptAt        DateTime?    @map("last_attempt_at") @db.Timestamptz(6)
  submittedAt          DateTime?    @map("submitted_at") @db.Timestamptz(6)
  processedAt          DateTime?    @map("processed_at") @db.Timestamptz(6)
  failedAt             DateTime?    @map("failed_at") @db.Timestamptz(6)
  reversedAt           DateTime?    @map("reversed_at") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  batch       PayoutBatch       @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  driver      Driver            @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bankAccount DriverBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  taxRule     TaxRule?          @relation(fields: [taxRuleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items       PayoutItem[]
  events      PayoutEvent[]

  @@unique([batchId, driverId], map: "uq_payouts_batch_driver")
  @@unique([provider, providerPayoutId], map: "uq_payouts_provider_payout", where: raw("(provider_payout_id IS NOT NULL)"))
  @@index([driverId, createdAt(sort: Desc)], map: "idx_payouts_driver_created")
  @@index([status, createdAt], map: "idx_payouts_status_created")
  @@index([bankAccountId], map: "idx_payouts_bank_account")
  @@map("driver_payouts")
}

/// The earnings carried by a payout. An earning can be INCLUDED or PAID in at most one payout
/// (partial unique index), so the same earning can never be paid twice.
model PayoutItem {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payoutId    String           @map("payout_id") @db.Uuid
  earningId   String           @map("earning_id") @db.Uuid
  amountPaise BigInt           @map("amount_paise")
  status      PayoutItemStatus @default(INCLUDED)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  payout  DriverPayout  @relation(fields: [payoutId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  earning DriverEarning @relation(fields: [earningId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([payoutId, earningId], map: "uq_payout_items_payout_earning")
  @@unique([earningId], map: "uq_payout_items_earning_active", where: raw("(status = ANY (ARRAY['INCLUDED'::payout_item_status, 'PAID'::payout_item_status]))"))
  @@index([earningId], map: "idx_payout_items_earning")
  @@map("payout_items")
}

/// Signature-verified payout-provider webhook events (mirror of payment_events).
model PayoutEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId         String    @unique(map: "uq_payout_events_event_id") @map("event_id") @db.VarChar(150)
  eventType       String    @map("event_type") @db.VarChar(100)
  provider        String    @default("RAZORPAYX") @db.VarChar(40)
  payload         Json
  signatureValid  Boolean   @map("signature_valid")
  payoutId        String?   @map("payout_id") @db.Uuid
  outcome         String?   @db.VarChar(40)
  attempts        Int       @default(0)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  processingError String?   @map("processing_error")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  payout DriverPayout? @relation(fields: [payoutId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([createdAt], map: "idx_payout_events_unprocessed", where: raw("(processed_at IS NULL)"))
  @@index([payoutId], map: "idx_payout_events_payout")
  @@map("payout_events")
}

/// Razorpay disputes (chargebacks) on customer payments. A disputed payment's earning is put
/// ON_HOLD so it is never paid out without an admin decision.
model PaymentDispute {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          String   @default("RAZORPAY") @db.VarChar(40)
  providerDisputeId String   @map("provider_dispute_id") @db.VarChar(100)
  providerPaymentId String   @map("provider_payment_id") @db.VarChar(100)
  /// Booking the disputed payment belongs to, when it is one of ours.
  bookingId         String?  @map("booking_id") @db.Uuid
  amountPaise       BigInt   @map("amount_paise")
  /// Provider status: open, under_review, won, lost, closed, ...
  status            String   @db.VarChar(30)
  reasonCode        String?  @map("reason_code") @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, providerDisputeId], map: "uq_disputes_provider_dispute")
  @@index([providerPaymentId], map: "idx_disputes_provider_payment")
  @@index([bookingId], map: "idx_disputes_booking")
  @@map("payment_disputes")
}

/// A refund an admin requested (payment flow Phase 6): a provider refund of an online payment
/// through Razorpay, or a cash return of a cash collection. Each names exactly one source, a
/// completed collection or a paid historical prepaid payment, of its own booking and drop. The
/// source, amount, reason and decisions are immutable and the status only moves forward
/// (triggers). Nothing creates one automatically: refund policy is open (OPEN_DECISIONS L-7 to
/// L-10, L-21).
model PaymentRefund {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId           String    @map("booking_id") @db.Uuid
  /// The drop the source collection was for (per-drop collections only), else NULL.
  bookingStopId       String?   @map("booking_stop_id") @db.Uuid
  /// The source: a completed collection, or (below) a paid prepaid booking payment. Exactly one.
  sourceCollectionId  String?   @map("source_collection_id") @db.Uuid
  sourcePaymentId     String?   @map("source_payment_id") @db.Uuid
  /// PROVIDER or CASH_RETURNED (CHECK).
  kind                String    @db.VarChar(20)
  /// PENDING, PROCESSING, COMPLETED, FAILED, REFUSED or CANCELLED (CHECK, forward only).
  status              String    @db.VarChar(20)
  /// What the booking's facts showed when it was requested (CANCELLED_BEFORE_HANDOVER,
  /// CANCELLED_AFTER_HANDOVER, UNDELIVERED_DROP, COMPLETED_BOOKING). For review; decides nothing.
  refundCase          String    @map("refund_case") @db.VarChar(40)
  amountPaise         BigInt    @map("amount_paise")
  currency            String    @default("INR") @db.Char(3)
  reason              String    @db.VarChar(500)
  requestedByUserId   String    @map("requested_by_user_id") @db.Uuid
  /// admin:<user>:<Idempotency-Key>, so a retried request never creates a second refund.
  idempotencyKey      String    @unique(map: "uq_refunds_idempotency_key") @map("idempotency_key") @db.VarChar(150)
  /// PROVIDER only: RAZORPAY.
  provider            String?   @db.VarChar(40)
  /// PROVIDER only: the source's own Razorpay payment (pay_...).
  providerPaymentId   String?   @map("provider_payment_id") @db.VarChar(100)
  /// PROVIDER only: the Razorpay refund (rfnd_...), recorded once.
  providerRefundId    String?   @map("provider_refund_id") @db.VarChar(100)
  /// The last refund status Razorpay reported (pending, processed, failed).
  providerStatus      String?   @map("provider_status") @db.VarChar(30)
  /// The bank reference (ARN / RRN) Razorpay reports for a processed refund.
  providerReference   String?   @map("provider_reference") @db.VarChar(100)
  /// CASH_RETURNED only: KEPT or CREDITED_TO_WALLET, as the admin stated.
  feeTreatment        String?   @map("fee_treatment") @db.VarChar(30)
  /// CREDITED_TO_WALLET only: the collection's platform fee, credited back once.
  feeCreditPaise      BigInt?   @map("fee_credit_paise")
  /// CREDITED_TO_WALLET only: the REFUND_REVERSAL ledger credit.
  walletTransactionId String?   @unique(map: "uq_refunds_wallet_tx") @map("wallet_transaction_id") @db.Uuid
  failureReason       String?   @map("failure_reason") @db.VarChar(200)
  /// Provider submissions claimed (a lease: two workers never submit the same refund at once).
  submitAttempts      Int       @default(0) @map("submit_attempts")
  lastSubmittedAt     DateTime? @map("last_submitted_at") @db.Timestamptz(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  failedAt            DateTime? @map("failed_at") @db.Timestamptz(6)
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId   String?   @map("cancelled_by_user_id") @db.Uuid
  cancellationReason  String?   @map("cancellation_reason") @db.VarChar(500)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking           Booking                  @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite key: a refund can only name a drop of its own booking.
  bookingStop       BookingStop?             @relation(fields: [bookingId, bookingStopId], references: [bookingId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceCollection  PaymentCollection?       @relation(fields: [sourceCollectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourcePayment     Payment?                 @relation(fields: [sourcePaymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy       User                     @relation("RefundRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledBy       User?                    @relation("RefundCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  walletTransaction DriverWalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, providerRefundId], map: "uq_refunds_provider_refund", where: raw("(provider_refund_id IS NOT NULL)"))
  // One live (PENDING or PROCESSING) refund per source at a time.
  @@unique([sourceCollectionId], map: "uq_refunds_collection_live", where: raw("((source_collection_id IS NOT NULL) AND ((status)::text = ANY ((ARRAY['PENDING'::character varying, 'PROCESSING'::character varying])::text[])))"))
  @@unique([sourcePaymentId], map: "uq_refunds_payment_live", where: raw("((source_payment_id IS NOT NULL) AND ((status)::text = ANY ((ARRAY['PENDING'::character varying, 'PROCESSING'::character varying])::text[])))"))
  @@index([bookingId], map: "idx_refunds_booking")
  @@index([sourceCollectionId], map: "idx_refunds_collection")
  @@index([sourcePaymentId], map: "idx_refunds_payment")
  @@index([status, createdAt], map: "idx_refunds_status_created")
  @@map("payment_refunds")
}

/// M1 admin_actions: append-only audit of admin and ops-CLI actions on financial records
/// (fee rules, earning holds, bank account verification, payout batches).
model AdminAction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The admin who acted; NULL for the ops CLI and the payout scheduler.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(60)
  targetType  String   @map("target_type") @db.VarChar(40)
  targetId    String   @map("target_id") @db.VarChar(100)
  reason      String?
  details     Json     @default("{}")
  createdAt   DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([targetType, targetId, createdAt(sort: Desc)], map: "idx_admin_actions_target")
  @@index([actorUserId, createdAt(sort: Desc)], map: "idx_admin_actions_actor")
  @@map("admin_actions")
}

// ---------------------------------------------------------------------------------------------
// Fare module. Pricing is versioned and server-side only; a quote freezes the amounts the
// customer saw, and booking registration copies them. No payment code calculates a fare.
// ---------------------------------------------------------------------------------------------

/// A pricing version. Its config never changes: a pricing change is a new version with its own
/// start, and every quote records the version that priced it. Same lifecycle as fee rules.
model PricingVersion {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique, human-readable, e.g. PROTOTYPE-2026-10.
  code                String    @unique(map: "uq_pricing_versions_code") @db.VarChar(40)
  /// The pricing model the config is written for (CHECK in SQL), e.g. LEG_DISTANCE_V1.
  model               String    @db.VarChar(40)
  /// Rates and rules for the model, validated by the Fare module. Immutable.
  config              Json
  effectiveFrom       DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo         DateTime? @map("effective_to") @db.Timestamptz(6)
  active              Boolean   @default(true)
  /// Approval reference and why this version exists. Required.
  reason              String
  /// Admin who created it; NULL when created with the ops CLI.
  createdByUserId     String?   @map("created_by_user_id") @db.Uuid
  deactivatedAt       DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivatedByUserId String?   @map("deactivated_by_user_id") @db.Uuid
  deactivationReason  String?   @map("deactivation_reason")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy     User?       @relation("PricingVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deactivatedBy User?       @relation("PricingVersionDeactivatedBy", fields: [deactivatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  quotes        FareQuote[]
  bookings      Booking[]

  @@index([active, effectiveFrom(sort: Desc)], map: "idx_pricing_versions_lookup")
  @@map("pricing_versions")
}

/// A server-calculated fare for one route, valid until expires_at and usable for one booking.
/// Amounts are integer paise; the stops add up to the totals (deferred trigger).
model FareQuote {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  pricingVersionId String    @map("pricing_version_id") @db.Uuid
  vehicleCategory  String    @map("vehicle_category") @db.VarChar(50)
  /// Total goods weight, in grams.
  weightGrams      Int       @map("weight_grams")
  pickupLatitude   Decimal   @map("pickup_latitude") @db.Decimal(9, 6)
  pickupLongitude  Decimal   @map("pickup_longitude") @db.Decimal(9, 6)
  /// Total route distance, in metres.
  distanceMeters   Int       @map("distance_meters")
  /// Fare excluding taxes.
  farePaise        BigInt    @map("fare_paise")
  taxPaise         BigInt    @map("tax_paise")
  /// What the customer (or the receivers together) pays: fare + tax.
  payablePaise     BigInt    @map("payable_paise")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set once, when a booking is registered from this quote.
  redeemedAt       DateTime? @map("redeemed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pricingVersion PricingVersion  @relation(fields: [pricingVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stops          FareQuoteStop[]
  booking        Booking?

  @@index([customerId, createdAt(sort: Desc)], map: "idx_fare_quotes_customer_created")
  @@index([pricingVersionId], map: "idx_fare_quotes_pricing_version")
  @@map("fare_quotes")
}

/// One drop of a quote: its location, the leg that reaches it and what that drop costs.
model FareQuoteStop {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId        String  @map("quote_id") @db.Uuid
  /// 1-based delivery order.
  sequence       Int     @db.SmallInt
  latitude       Decimal @db.Decimal(9, 6)
  longitude      Decimal @db.Decimal(9, 6)
  /// Distance from the previous point (the pickup for stop 1), in metres.
  distanceMeters Int     @map("distance_meters")
  farePaise      BigInt  @map("fare_paise")
  taxPaise       BigInt  @map("tax_paise")
  payablePaise   BigInt  @map("payable_paise")

  quote       FareQuote    @relation(fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookingStop BookingStop?

  @@unique([quoteId, sequence], map: "uq_fare_quote_stops_sequence")
  @@map("fare_quote_stops")
}

// ---------------------------------------------------------------------------------------------
// Audit and reconciliation (payment flow Phase 7). Nothing here moves money.
// ---------------------------------------------------------------------------------------------

/// Append-only log of every change to a financial record (bookings, trips, stops, payments,
/// collections, settlements, disputes, refunds, earnings, payout batches, payouts, payout items,
/// wallet ledger entries and admin actions), written by database triggers in the same
/// transaction as the change. CREATED carries the new row; an update carries the changed columns
/// ({column: {from, to}}). The actor and request come from transaction-local settings the
/// service layer sets; a change made without them is UNATTRIBUTED. No role can update, delete
/// or truncate it, or insert into it directly (triggers); the API role can only read it.
model FinancialEvent {
  id              BigInt   @id @default(autoincrement())
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz(6)
  /// PostgreSQL transaction id: events with the same value were committed together.
  transactionId   BigInt   @map("transaction_id")
  /// BOOKING, TRIP, BOOKING_STOP, PAYMENT, PAYMENT_COLLECTION, PAYMENT_SETTLEMENT,
  /// PAYMENT_DISPUTE, PAYMENT_REFUND, DRIVER_EARNING, PAYOUT_BATCH, DRIVER_PAYOUT, PAYOUT_ITEM,
  /// WALLET_TRANSACTION or ADMIN_ACTION (CHECK).
  entityType      String   @map("entity_type") @db.VarChar(40)
  entityId        String   @map("entity_id") @db.Uuid
  /// CREATED, STATUS_CHANGED, PAYMENT_STATUS_CHANGED, UPDATED or DELETED (CHECK).
  action          String   @db.VarChar(30)
  statusFrom      String?  @map("status_from") @db.VarChar(40)
  statusTo        String?  @map("status_to") @db.VarChar(40)
  bookingId       String?  @map("booking_id") @db.Uuid
  driverId        String?  @map("driver_id") @db.Uuid
  /// The record's own amount (fare, payable, collected, refunded, gross earning, payout, ...).
  amountPaise     BigInt?  @map("amount_paise")
  changes         Json
  /// ADMIN, DRIVER, CUSTOMER, ENGINE, PROVIDER, SYSTEM or UNATTRIBUTED (CHECK).
  actorType       String   @map("actor_type") @db.VarChar(20)
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  /// The HTTP request id (X-Request-Id), or the reconciliation run id for a job.
  requestId       String?  @map("request_id") @db.VarChar(100)
  /// The route ("POST /v1/admin/refunds"), webhook ("webhook razorpay payment.captured") or job.
  origin          String?  @db.VarChar(150)
  /// The provider webhook event that caused the change, when one did.
  providerEventId String?  @map("provider_event_id") @db.VarChar(150)
  /// The database role that made the change (session_user).
  dbRole          String   @map("db_role") @db.VarChar(63)

  @@index([bookingId, id], map: "idx_financial_events_booking", where: raw("(booking_id IS NOT NULL)"))
  @@index([entityType, entityId, id], map: "idx_financial_events_entity")
  @@index([driverId, id], map: "idx_financial_events_driver", where: raw("(driver_id IS NOT NULL)"))
  @@index([requestId], map: "idx_financial_events_request", where: raw("(request_id IS NOT NULL)"))
  @@index([actorUserId, id], map: "idx_financial_events_actor", where: raw("(actor_user_id IS NOT NULL)"))
  @@index([occurredAt], map: "idx_financial_events_occurred")
  @@map("financial_events")
}

/// One run of a reconciliation job: COLLECTION_RECOVERY or RECONCILIATION (CHECK). At most one
/// RUNNING run per job; a run that outlives its lease is closed ABANDONED by the next one. A
/// finished run never changes (trigger).
model ReconciliationRun {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job               String    @db.VarChar(40)
  /// SCHEDULE or ADMIN (CHECK).
  triggeredBy       String    @map("triggered_by") @db.VarChar(20)
  /// RUNNING, COMPLETED, FAILED or ABANDONED (CHECK).
  status            String    @default("RUNNING") @db.VarChar(20)
  /// What the run looked at (for example {"since": ...}); {} is everything.
  scope             Json      @default("{}")
  requestedByUserId String?   @map("requested_by_user_id") @db.Uuid
  startedAt         DateTime  @default(dbgenerated("clock_timestamp()")) @map("started_at") @db.Timestamptz(6)
  leaseExpiresAt    DateTime  @map("lease_expires_at") @db.Timestamptz(6)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(6)
  /// Counts and per-check results of the run.
  summary           Json      @default("{}")
  error             String?   @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  requestedBy       User?                   @relation("ReconciliationRunRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  findingsFirstSeen ReconciliationFinding[] @relation("FindingFirstRun")
  findingsLastSeen  ReconciliationFinding[] @relation("FindingLastRun")

  @@unique([job], map: "uq_reconciliation_runs_running", where: raw("((status)::text = 'RUNNING'::text)"))
  @@index([job, startedAt(sort: Desc)], map: "idx_reconciliation_runs_job_started")
  @@map("reconciliation_runs")
}

/// A mismatch a reconciliation run detected, kept for an admin. Recording one moves no money;
/// only an admin resolves it, with a note. One OPEN finding per fingerprint (the same condition
/// seen again counts another sighting); a condition a complete run no longer sees is marked
/// cleared. Identity and first sighting are immutable, and a resolved finding is never reopened
/// (triggers).
model ReconciliationFinding {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// PROVIDER_PAID_INTERNAL_PENDING, INTERNAL_PAID_PROVIDER_NOT_PAID, EARNING_SOURCE_MISMATCH,
  /// SETTLEMENT_MISMATCH, PAYOUT_MISMATCH, REFUND_MISMATCH, WALLET_MISMATCH, STALE_PENDING,
  /// DUPLICATE_PROVIDER_EVENT or PROVIDER_EVENT_ANOMALY (CHECK).
  category            String    @db.VarChar(40)
  /// The check's problem code, e.g. PROVIDER_PAID_PAYMENT_PENDING.
  kind                String    @db.VarChar(60)
  /// INFO, WARNING or CRITICAL (CHECK).
  severity            String    @db.VarChar(10)
  /// DATABASE, PROVIDER (a read from Razorpay or RazorpayX) or RECOVERY (CHECK).
  source              String    @db.VarChar(20)
  /// Stable identity of the condition (kind and the records involved).
  fingerprint         String    @db.VarChar(300)
  /// OPEN or RESOLVED (CHECK).
  status              String    @default("OPEN") @db.VarChar(20)
  entityType          String?   @map("entity_type") @db.VarChar(40)
  entityId            String?   @map("entity_id") @db.VarChar(150)
  bookingId           String?   @map("booking_id") @db.Uuid
  driverId            String?   @map("driver_id") @db.Uuid
  /// The provider's id involved (pay_, qr_, plink_, pout_, rfnd_, setl_, or a webhook event id).
  providerRef         String?   @map("provider_ref") @db.VarChar(150)
  internalState       String?   @map("internal_state") @db.VarChar(60)
  providerState       String?   @map("provider_state") @db.VarChar(60)
  internalAmountPaise BigInt?   @map("internal_amount_paise")
  providerAmountPaise BigInt?   @map("provider_amount_paise")
  detail              String?   @db.VarChar(500)
  /// Related ids (paymentId, collectionId, earningId, payoutId, refundId, walletId, ...).
  refs                Json      @default("{}")
  occurrences         Int       @default(1)
  firstSeenAt         DateTime  @default(dbgenerated("clock_timestamp()")) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt          DateTime  @default(dbgenerated("clock_timestamp()")) @map("last_seen_at") @db.Timestamptz(6)
  firstRunId          String?   @map("first_run_id") @db.Uuid
  lastRunId           String?   @map("last_run_id") @db.Uuid
  /// Set when a complete run no longer saw the condition. Never removes the finding.
  clearedAt           DateTime? @map("cleared_at") @db.Timestamptz(6)
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedByUserId    String?   @map("resolved_by_user_id") @db.Uuid
  resolutionNote      String?   @map("resolution_note") @db.VarChar(500)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  firstRun   ReconciliationRun? @relation("FindingFirstRun", fields: [firstRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lastRun    ReconciliationRun? @relation("FindingLastRun", fields: [lastRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy User?              @relation("FindingResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([fingerprint], map: "uq_reconciliation_findings_open", where: raw("((status)::text = 'OPEN'::text)"))
  @@index([fingerprint], map: "idx_reconciliation_findings_fingerprint")
  @@index([status, category, lastSeenAt(sort: Desc)], map: "idx_reconciliation_findings_status")
  @@index([bookingId], map: "idx_reconciliation_findings_booking", where: raw("(booking_id IS NOT NULL)"))
  @@map("reconciliation_findings")
}
