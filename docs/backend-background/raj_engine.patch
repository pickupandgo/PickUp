@@ -0,0 +1,110 @@
+import { RidesService } from './rides.service';
+const rideId = '00000000-0000-4000-8000-000000000001';
+const offerId = '00000000-0000-4000-8000-000000000002';
+function setup() {
+  const row = {
+    id: offerId,
+    bookingId: rideId,
+    driverSubject: 'driver-a',
+    status: 'REQUESTED',
+    expiresAt: new Date(Date.now() + 30000),
+    booking: {
+      externalRef: rideId,
+      status: 'OPEN',
+      vehicleCategory: 'MINI_TRUCK',
+    },
+  };
+  const prisma = {
+    engineOffer: {
+      findFirst: jest.fn(({ where }: any) =>
+        Promise.resolve(
+          where.driverSubject === row.driverSubject &&
+            (!where.bookingId || where.bookingId === row.bookingId) &&
+            row.status === 'REQUESTED' &&
+            row.expiresAt > new Date()
+            ? row
+            : null,
+        ),
+      ),
+    },
+  };
+  const backend = {
+    call: jest.fn().mockResolvedValue({
+      kind: 'OK',
+      body: {
+        toPickup: { distanceMeters: 5600, durationSeconds: 1020 },
+        delivery: { distanceMeters: 12000, durationSeconds: 2000 },
+      },
+    }),
+  };
+  const drivers = {
+    requireEligibleForNewWork: jest.fn().mockResolvedValue(undefined),
+  };
+  const service = new RidesService(
+    prisma as never,
+    backend as never,
+    {} as never,
+    drivers as never,
+    {} as never,
+    {} as never,
+  );
+  return { row, prisma, backend, service };
+}
+const fix = () => ({
+  latitude: 26.2,
+  longitude: 73.1,
+  capturedAt: Date.now(),
+  accuracy: 5,
+});
+it('routes only an authenticated targeted offer with server-owned itinerary and no amount', async () => {
+  const h = setup();
+  const result = await h.service.offerRoadRoute('driver-a', rideId, fix());
+  expect(result.offerId).toBe(offerId);
+  expect(h.backend.call).toHaveBeenCalledWith(
+    expect.objectContaining({
+      path: '/v1/internal/routes/offer',
+      body: {
+        externalRef: rideId,
+        origin: { latitude: 26.2, longitude: 73.1 },
+      },
+    }),
+  );
+});
+it('refuses a foreign driver, expired offer and stale GPS before provider access', async () => {
+  const h = setup();
+  await expect(
+    h.service.offerRoadRoute('other-driver', rideId, fix()),
+  ).rejects.toMatchObject({ status: 404 });
+  h.row.expiresAt = new Date(0);
+  await expect(
+    h.service.offerRoadRoute('driver-a', rideId, fix()),
+  ).rejects.toMatchObject({ status: 404 });
+  await expect(
+    h.service.offerRoadRoute('driver-a', rideId, { ...fix(), capturedAt: 0 }),
+  ).rejects.toMatchObject({ status: 400 });
+  expect(h.backend.call).not.toHaveBeenCalled();
+});
+it('discards a route when cancellation wins while the provider request is in flight', async () => {
+  const h = setup();
+  h.backend.call.mockImplementationOnce(() => {
+    h.row.status = 'CANCELLED';
+    return Promise.resolve({
+      kind: 'OK',
+      body: {
+        toPickup: { distanceMeters: 1, durationSeconds: 1 },
+        delivery: { distanceMeters: 1, durationSeconds: 1 },
+      },
+    });
+  });
+  await expect(
+    h.service.offerRoadRoute('driver-a', rideId, fix()),
+  ).rejects.toMatchObject({ status: 404 });
+});
+it('limits repeated requests for the same driver', async () => {
+  const h = setup();
+  await h.service.offerRoadRoute('driver-a', rideId, fix());
+  await expect(
+    h.service.offerRoadRoute('driver-a', rideId, fix()),
+  ).rejects.toMatchObject({ status: 429 });
+  expect(h.backend.call).toHaveBeenCalledTimes(1);
+});
