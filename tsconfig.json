{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // `engine/` is a local checkout of the separate NestJS backend repo. It has
  // its own tsconfig (decorators, Jest globals) and must not be type-checked
  // as part of the app.
  "exclude": ["node_modules", "engine", ".verify-dist", "dist"]
}
